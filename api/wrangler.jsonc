{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bill-splitter-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bill-splitter",
      "database_id": "d5aee832-c567-4d27-b12b-5f8f019d57d9",
      "migrations_dir": "migrations"
    }
  ]
}
