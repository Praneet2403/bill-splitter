{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npx pnpm@12.16.1 install",
  "buildCommand": "npx pnpm@12.16.1 --filter bill-splitter-web build",
  "outputDirectory": "web/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://bill-splitter-api.duttapraneet.workers.dev/api/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
